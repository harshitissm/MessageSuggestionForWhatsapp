{
  "manifest_version": 3,
  "name": "WhatsApp suggestions",
  "version": "1.0.0",
  "author": "Harshit Goyal",
  "icons": {
    "16": "icons/chat-16.png",
    "32": "icons/chat-32.png",
    "48": "icons/chat-48.png",
    "128": "icons/chat-128.png"
  },
  "description": "Generating response for WhatsApp using GPT",
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": ["https://*.openai.com/"],
  "action": {
    "default_title": "GPT answers for WhatsApp™ web"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "run_at": "document_idle",
      "js": ["parser.js", "uiStuff.js", "confirmDialog.js", "contentScript.js"]
    }
  ],
  "permissions": ["storage"]
}
